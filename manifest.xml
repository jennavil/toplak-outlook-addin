<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
 xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
 xsi:type="MailApp">
 <Id>8f4a8c6e-3f9b-4d2d-9f35-b9e9a013a7de</Id>
 <Version>1.0.0.2</Version>
 <ProviderName>Toplak Bau GmbH</ProviderName>
 <DefaultLocale>de-CH</DefaultLocale>
 <DisplayName DefaultValue="Toplak Bau"/>
 <Description DefaultValue="E-Mail-Vorlagen für Toplak Bau."/>
 <IconUrl DefaultValue="https://jennavil.github.io/toplak-outlook-addin/icon-64.png"/>
 <HighResolutionIconUrl DefaultValue="https://jennavil.github.io/toplak-outlook-addin/icon-128.png"/>
 <SupportUrl DefaultValue="https://jennavil.github.io/toplak-outlook-addin/taskpane.html"/>
 <AppDomains><AppDomain>https://jennavil.github.io</AppDomain></AppDomains>
 <Hosts><Host Name="Mailbox"/></Hosts>
 <Requirements><Sets><Set Name="Mailbox" MinVersion="1.3"/></Sets></Requirements>
 <FormSettings>
  <Form xsi:type="ItemEdit">
   <DesktopSettings><SourceLocation DefaultValue="https://jennavil.github.io/toplak-outlook-addin/taskpane.html"/></DesktopSettings>
  </Form>
 </FormSettings>
 <Permissions>ReadWriteItem</Permissions>
 <Rule xsi:type="RuleCollection" Mode="Or"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/></Rule>
 <DisableEntityHighlighting>false</DisableEntityHighlighting>
 <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
  <Requirements><bt:Sets DefaultMinVersion="1.3"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
  <Hosts>
   <Host xsi:type="MailHost">
    <DesktopFormFactor>
     <FunctionFile resid="Commands.Url"/>
     <ExtensionPoint xsi:type="MessageComposeCommandSurface">
      <OfficeTab id="TabDefault">
       <Group id="ToplakBau.Group">
        <Label resid="Group.Label"/>
        <Control xsi:type="Button" id="ToplakBau.Button">
         <Label resid="Button.Label"/>
         <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
         <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
         <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
        </Control>
       </Group>
      </OfficeTab>
     </ExtensionPoint>
    </DesktopFormFactor>
   </Host>
  </Hosts>
  <Resources>
   <bt:Images>
    <bt:Image id="Icon.16" DefaultValue="https://jennavil.github.io/toplak-outlook-addin/icon-16.png"/>
    <bt:Image id="Icon.32" DefaultValue="https://jennavil.github.io/toplak-outlook-addin/icon-32.png"/>
    <bt:Image id="Icon.80" DefaultValue="https://jennavil.github.io/toplak-outlook-addin/icon-80.png"/>
   </bt:Images>
   <bt:Urls>
    <bt:Url id="Commands.Url" DefaultValue="https://jennavil.github.io/toplak-outlook-addin/commands.html"/>
    <bt:Url id="Taskpane.Url" DefaultValue="https://jennavil.github.io/toplak-outlook-addin/taskpane.html"/>
   </bt:Urls>
   <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="Toplak Bau"/><bt:String id="Button.Label" DefaultValue="TOPLAK BAU"/></bt:ShortStrings>
   <bt:LongStrings><bt:String id="Button.Description" DefaultValue="E-Mail vorbereiten"/></bt:LongStrings>
  </Resources>
 </VersionOverrides>
</OfficeApp>